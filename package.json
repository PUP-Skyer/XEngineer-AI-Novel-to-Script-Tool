{
  "name": "ai-script-game",
  "private": true,
  "version": "0.1.0",
  "description": "AI 小说转剧本 + 剧本杀游戏平台",
  "scripts": {
    "dev:admin": "pnpm --filter admin-portal dev",
    "dev:user": "pnpm --filter user-portal dev",
    "dev:server": "pnpm --filter @asg/server dev",
    "dev:all": "pnpm run --parallel dev:admin dev:user dev:server",
    "build": "pnpm run --parallel build:admin build:user",
    "build:admin": "pnpm --filter admin-portal build",
    "build:user": "pnpm --filter user-portal build",
    "build:server": "pnpm --filter @asg/server build",
    "lint": "eslint . --ext .ts,.tsx,.vue",
    "lint:fix": "eslint . --ext .ts,.tsx,.vue --fix",
    "format": "prettier --write \"**/*.{ts,tsx,vue,json,css,scss}\"",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.27.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
