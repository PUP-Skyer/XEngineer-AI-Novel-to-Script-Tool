# ========== 应用配置 ==========
APP_NAME=AI-Script-Game
APP_PORT=3000
APP_ENV=development
APP_URL=http://localhost:3000
APP_FRONTEND_URL=http://localhost:5173
APP_ADMIN_URL=http://localhost:5174

# ========== 数据库 ==========
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=ai_script_game
DB_SYNCHRONIZE=true
DB_LOGGING=true

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== JWT ==========
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ========== AI 模型 ==========
AI_DEFAULT_PROVIDER=openai
AI_OPENAI_API_KEY=sk-xxx
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_ANTHROPIC_API_KEY=sk-ant-xxx
AI_DEEPSEEK_API_KEY=sk-xxx
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ========== 文件存储 ==========
STORAGE_TYPE=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-script-game

# ========== 邮件 (可选) ==========
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=xxx
